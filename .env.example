# "mock" (default) uses the built-in deterministic scorer; "api" calls the real Jev API.
JEV_MODE=mock

# Required when JEV_MODE=api. Get a key at https://typesafe.ai
JEV_API_KEY=

# Optional overrides (defaults shown). Other providers: https://api.aimlapi.com/v1/decisions
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
