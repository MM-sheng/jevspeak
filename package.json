{
  "name": "jevspeak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "set-key": "node scripts/set-key.mjs",
    "set-key:vercel": "node scripts/set-key.mjs --vercel",
